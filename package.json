{
  "name": "@chaoslabz/chromacraft",
  "version": "0.1.0",
  "description": "A fully stylizable color picker component library - full picker, strip mode, gradient, dropper",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./styles": "./dist/styles/chromacraft.css"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": ["color-picker", "react", "tailwind", "gradient", "dropper", "color-strip"],
  "author": "ChaosLabz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaosLabz/chromacraft"
  }
}
